<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="VetSaludPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.vetsalud.entity.Propietario</class>
        <class>com.vetsalud.entity.Mascota</class>
        <class>com.vetsalud.entity.Veterinario</class>
        <class>com.vetsalud.entity.HistorialClinico</class>
        <class>com.vetsalud.entity.Usuario</class>
        <class>com.vetsalud.entity.Rol</class>
        <class>com.vetsalud.entity.UsuarioRol</class>
        <class>com.vetsalud.entity.Auditoria</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Conexión a MySQL/MariaDB en XAMPP -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/vetsalud_db?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- El esquema lo controla vetsalud_db.sql: Hibernate NO modifica las tablas -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>